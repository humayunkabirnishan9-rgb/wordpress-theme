{
  "version": "0.4",
  "title": "BlueWireSEO Single Portfolio Template",
  "type": "single-post",
  "content": [
    {
      "id": "bws_single_port_hero",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "background_background": "classic",
        "background_color": "#F4F6F9",
        "padding": { "unit": "px", "top": "60", "bottom": "60", "isLinked": false }
      },
      "elements": [
        {
          "id": "bws_single_port_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "bws_single_port_title",
              "elType": "widget",
              "widgetType": "theme-post-title",
              "settings": { "header_size": "h1" }
            },
            {
              "id": "bws_single_port_excerpt",
              "elType": "widget",
              "widgetType": "theme-post-excerpt",
              "settings": {}
            }
          ]
        }
      ]
    },
    {
      "id": "bws_single_port_body",
      "elType": "section",
      "settings": {
        "padding": { "unit": "px", "top": "50", "bottom": "50", "isLinked": false }
      },
      "elements": [
        {
          "id": "bws_single_port_content_col",
          "elType": "column",
          "settings": { "_column_size": 70 },
          "elements": [
            {
              "id": "bws_single_port_content",
              "elType": "widget",
              "widgetType": "theme-post-content",
              "settings": {}
            }
          ]
        },
        {
          "id": "bws_single_port_sidebar_col",
          "elType": "column",
          "settings": { "_column_size": 30 },
          "elements": [
            {
              "id": "bws_single_port_sidebar_cta",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Discuss Similar Project",
                "link": { "url": "/contact/" },
                "size": "md"
              }
            }
          ]
        }
      ]
    }
  ]
}
